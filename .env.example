# Documentation template. Export settings in your shell; Slurm inherits them.
# Never commit a populated credentials file.
WANDB_MODE=disabled
GRID_USE_WANDB=false
WANDB_API_KEY=
HF_TOKEN=
# Set FAIRDIVERSE_ROOT when submitting from a different directory.
FAIRDIVERSE_ROOT=
FAIRDIVERSE_PYTHON=python
